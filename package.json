{
  "name": "pgd-skofljica-site",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "format:check": "prettier --check astro.config.mjs tailwind.config.mjs tsconfig.json package.json scripts \"src/**/*.{astro,ts,css}\"",
    "audit": "bun audit",
    "size": "node scripts/report-size.mjs",
    "verify": "bun run format:check && bun run audit && bun run build && bun run size",
    "prepare": "git config --local include.path ../.githooks/.gitconfig",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.4",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "vite": "^8.3.5"
  }
}
