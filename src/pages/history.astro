---
import LightboxImage from "@/components/LightboxImage.astro";
import { historyEntries } from "@/const/history";
import Page from "@/layouts/Page.astro";
---

<Page title="Zgodovina | PGD Škofljica">
  <section class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <h1
        class="mb-5 text-center text-4xl leading-tight font-extrabold md:text-5xl"
      >
        Zgodovina PGD Škofljica
      </h1>

      <div class="grid gap-4">
        {
          historyEntries.map((entry) => (
            <article class="grid gap-2">
              <h2 class="mt-2 text-2xl leading-tight font-extrabold md:text-3xl">
                {entry.period}
              </h2>
              {entry.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {entry.image && (
                <figure class="mt-3 mb-1">
                  <LightboxImage
                    src={entry.image.src}
                    alt={entry.image.alt}
                    class="mx-auto max-w-3xl"
                    sizes="(min-width: 768px) 48rem, 100vw"
                  />
                </figure>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Page>
