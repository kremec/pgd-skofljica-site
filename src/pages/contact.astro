---
import Page from "@/layouts/Page.astro";
---

<Page title="Kontakt | PGD Škofljica">
  <section class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h1
        class="mb-5 text-center text-4xl leading-tight font-extrabold md:text-5xl"
      >
        Kontakt
      </h1>

      <div class="mb-6 grid items-start gap-5 text-center lg:grid-cols-3">
        <p>
          Spletna stran:
          <a href="https://www.pgd-skofljica.si">pgd-skofljica.si</a><br />
          E-pošta: <a href="mailto:pgdskofljica@siol.net"
            >pgdskofljica@siol.net</a
          >
        </p>
        <p>
          Predsednik:<br />
          Franc Kraškovic:
          <a href="tel:+38631826200">+386 31 826 200</a>
        </p>
        <p>
          Poveljnik:<br />
          Matic Trtnik:
          <a href="tel:+38641561934">+386 41 561 934</a>
        </p>
      </div>

      <iframe
        class="aspect-square min-h-96 w-full rounded-lg border-0 shadow-lg sm:aspect-video sm:min-h-80"
        title="Lokacija PGD Škofljica na zemljevidu"
        src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d2772.5229962566063!2d14.575417000000002!3d45.980786!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47652ec4634d8427%3A0x3b4f626ac7b29a!2sProstovoljno%20gasilsko%20dru%C5%A1tvo%20%C5%A0kofljica!5e0!3m2!1sen!2ssi!4v1708032647583!5m2!1sen!2ssi"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
  </section>
</Page>
