---
import VehicleCard from "@/components/VehicleCard.astro";
import { historicVehicles, operativeVehicles } from "@/const/vehicles";
import Page from "@/layouts/Page.astro";
---

<Page title="Vozni park | PGD Škofljica">
  <section class="mx-auto max-w-screen-2xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <h1
        class="mb-5 text-center text-4xl leading-tight font-extrabold md:text-5xl"
      >
        Vozni park
      </h1>

      <h2 class="text-center text-2xl font-extrabold">Operativna vozila</h2>
      <div
        class="mt-2 mb-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >
        {operativeVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}
      </div>

      <h2 class="mb-4 text-center text-2xl font-extrabold">Vozila skozi čas</h2>
      <div
        class="mt-2 mb-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >
        {historicVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}
      </div>
    </div>
  </section>
</Page>
