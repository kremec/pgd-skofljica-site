---
import LightboxImage from "@/components/LightboxImage.astro";
import SocialMediaWidget from "@/components/SocialMediaWidget.astro";
import Page from "@/layouts/Page.astro";
import logo from "@/assets/images/brand/PGD_logo_znak.webp";
import operativa from "@/assets/images/home/operativa.webp";

import { Image } from "astro:assets";
---

<Page>
  <section
    class="mx-auto max-w-screen-2xl px-4 py-10 after:clear-both after:block after:content-[''] sm:px-6 lg:px-8"
  >
    <div
      class="mx-auto mb-10 w-full max-w-4xl lg:float-left lg:mr-10 lg:max-w-xl"
    >
      <div class="flex items-center gap-4 text-center">
        <Image
          src={logo}
          alt="Znak PGD Škofljica"
          width={128}
          class="w-20 sm:w-32"
          loading="eager"
          decoding="async"
        />
        <h1 class="text-2xl leading-tight font-black md:text-4xl">
          Prostovoljno gasilsko<br />društvo Škofljica
        </h1>
      </div>

      <div class="my-5 border-t border-zinc-200"></div>

      <LightboxImage
        src={operativa}
        alt="Operativni gasilci PGD Škofljica"
        class="rounded-lg bg-white shadow-lg"
        sizes="(min-width: 1024px) 36rem, 100vw"
      />

      <div class="mt-4 text-center">
        <h2 class="mt-4 mb-3 text-2xl leading-tight font-extrabold">O nas</h2>
        <p class="mb-4">
          Smo društvo III. kategorije in osrednje društvo v občini Škofljica. V
          občini Škofljica deluje šest gasilskih društev, združenih v Gasilsko
          zvezo Škofljica.
        </p>
        <p class="mb-4">
          PGD Škofljica je bilo ustanovljeno leta 1898 in je najstarejše društvo
          v občini. Delujemo na območju Škofljice in vasi Zalog, Glinek,
          Gumnišče, Gorenje Blato, Reber, Dole pri Škofljici in Pleše.
        </p>
        <p class="mb-4">
          Posredujemo pri gašenju požarov, ob poplavah, neurjih in drugih
          nesrečah. Za uspešno posredovanje na intervencijah imamo gasilska
          vozila GVC-1, GVM, AC 16/50, GV-1, in GVC 16/35.
        </p>
      </div>
    </div>

    <section class="min-w-0 text-center">
      <h2 class="mt-4 mb-3 text-2xl leading-tight font-extrabold">
        Novice in objave
      </h2>
      <SocialMediaWidget />
    </section>
  </section>
</Page>
