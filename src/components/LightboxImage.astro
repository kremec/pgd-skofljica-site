---
import { Picture } from "astro:assets";

import type { ImageMetadata } from "astro";

type ImageFit =
  | "fill"
  | "contain"
  | "cover"
  | "none"
  | "scale-down"
  | (string & {});

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  priority?: boolean;
  widths?: number[];
  sizes?: string;
  fit?: ImageFit;
  position?: string;
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  priority = false,
  widths = [320, 640, 960],
  sizes = "100vw",
  fit,
  position,
} = Astro.props;

const responsiveWidths = widths.filter((width) => width <= src.width);
if (responsiveWidths.length === 0) responsiveWidths.push(src.width);
---

<a
  class:list={[
    "block w-full cursor-zoom-in overflow-hidden rounded-t-lg border-0 bg-transparent p-0",
    className,
  ]}
  href={src.src}
  data-lightbox
>
  <Picture
    src={src}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={responsiveWidths}
    sizes={sizes}
    quality="mid"
    fit={fit}
    position={position}
    loading={priority ? "eager" : loading}
    priority={priority}
    decoding="async"
    class="block h-auto w-full"
  />
</a>

<dialog
  class="relative m-auto max-h-screen max-w-screen border-0 bg-transparent p-0 backdrop:bg-black/80"
  aria-label="Povečana slika"
  data-lightbox-dialog
>
  <form method="dialog">
    <button
      class="absolute top-3 right-3 grid size-11 cursor-pointer place-items-center rounded-full border-0 bg-white/95 pb-1 text-3xl leading-none text-zinc-800 shadow-lg transition hover:bg-white"
      type="submit"
      aria-label="Zapri sliko"
    >
      &times;
    </button>
  </form>
  <img class="block max-h-screen max-w-screen rounded-md" alt="" />
</dialog>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;

    const link = event.target.closest<HTMLAnchorElement>("a[data-lightbox]");
    if (!link) {
      if (event.target instanceof HTMLDialogElement) event.target.close();
      return;
    }

    event.preventDefault();

    const dialog = link.nextElementSibling;
    const preview = dialog?.querySelector("img");
    const image = link.querySelector("img");
    if (
      !(dialog instanceof HTMLDialogElement) ||
      !(preview instanceof HTMLImageElement) ||
      !(image instanceof HTMLImageElement)
    ) {
      return;
    }

    preview.src = link.href;
    preview.alt = image.alt;
    dialog.showModal();
  });
</script>
