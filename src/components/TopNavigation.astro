---
import {
  CalendarDays,
  FireExtinguisher,
  Mail,
  Menu,
  Truck,
} from "lucide-astro";

const navItems = [
  ["/history", "Zgodovina", CalendarDays],
  ["/vehicles", "Vozni park", Truck],
  ["/youth", "Mladina", FireExtinguisher],
  ["/contact", "Kontakt", Mail],
] as const;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header
  class="sticky top-0 z-20 border-b border-zinc-200 bg-white/95 shadow-sm backdrop-blur"
>
  <nav
    class="mx-auto max-w-screen-2xl lg:flex lg:min-h-14 lg:items-stretch lg:px-4"
    aria-label="Glavna navigacija"
  >
    <div
      class="flex min-h-14 items-center lg:min-h-0 lg:flex-none lg:items-stretch"
      data-site-nav
    >
      <a
        class:list={[
          "inline-flex min-w-0 flex-auto items-center px-4 text-lg font-extrabold whitespace-nowrap text-zinc-800 no-underline hover:text-red-900 lg:flex-none lg:px-2 lg:pr-6 lg:text-base",
          currentPath === "/" && "text-red-900",
        ]}
        href="/"
        aria-current={currentPath === "/" ? "page" : undefined}
      >
        PGD ŠKOFLJICA
      </a>
      <button
        class="grid size-14 cursor-pointer place-items-center border-0 bg-transparent p-0 text-zinc-800 hover:text-red-900 lg:hidden"
        type="button"
        aria-label="Odpri navigacijo"
        aria-controls="site-menu"
        aria-expanded="false"
        data-site-menu-button
      >
        <Menu class="size-5 shrink-0" aria-hidden="true" />
      </button>
    </div>

    <ul
      id="site-menu"
      class="hidden list-none border-t border-zinc-200 bg-white p-0 lg:flex lg:min-w-0 lg:flex-auto lg:items-stretch lg:border-t-0 lg:border-l"
      data-site-menu
    >
      {
        navItems.map(([path, label, Icon]) => {
          const active = currentPath === path;

          return (
            <li>
              <a
                class:list={[
                  "flex min-h-16 items-center gap-3 border-b border-zinc-200 px-4 py-2 text-sm font-bold text-zinc-700 no-underline hover:text-red-900 lg:inline-flex lg:h-full lg:min-h-0 lg:gap-2 lg:border-r lg:border-b-0 lg:px-5 lg:py-0",
                  active && "text-red-900",
                ]}
                href={path}
                aria-current={active ? "page" : undefined}
              >
                <Icon class="size-5 shrink-0" aria-hidden="true" />
                <span>{label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  document.querySelectorAll("[data-site-nav]").forEach((nav) => {
    const button = nav.querySelector<HTMLButtonElement>(
      "[data-site-menu-button]",
    );
    const menu = document.querySelector<HTMLElement>("#site-menu");
    if (!button || !menu) return;

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute(
        "aria-label",
        open ? "Zapri navigacijo" : "Odpri navigacijo",
      );
      menu.classList.toggle("hidden", !open);
      menu.classList.toggle("grid", open);
    };

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  });
</script>
